# ==============================================================================
# Ticket System API — Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit '.env' containing real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port the HTTP server will listen on.
# Default: 8080
PORT=8080

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC-SHA256 JWT tokens.
# REQUIRED: Must be a long, secure, random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Filepath to the SQLite database storage.
# Local default: ./database/tickets.db
# Docker default: /app/database/tickets.db
DATABASE_PATH=./database/tickets.db
